<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/super_alarm_widget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="12dp">

  <ImageView
    android:layout_width="28dp"
    android:layout_height="28dp"
    android:contentDescription="@string/app_name"
    android:src="@drawable/ic_widget_alarm" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/app_name"
      android:textColor="@color/widget_muted"
      android:textSize="12sp" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/super_alarm_widget_preview_time"
      android:textColor="@color/widget_on_background"
      android:textSize="22sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
